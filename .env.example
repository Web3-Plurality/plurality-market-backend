# =====================================================================
# plurality-market-backend — example env. Copy to .env and fill in.
# Port choices below avoid colliding with the prod stack (backend=5000,
# memory-studio=3000, prod-mcp=5050). Adjust if you have other defaults.
# =====================================================================

# ---- Server ----
PORT=5001
NODE_ENV=development
ENABLE_SWAGGER_DOCS=true
PLURALITY_BACKEND=http://localhost:5001

# CORS — only this origin can hit the API with credentials
MARKETPLACE_UI_ORIGIN=http://localhost:3001

# ---- Database (new, separate from prod) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=plurality_market
DB_USER=
DB_PASSWORD=

# ---- JWT (wallet-session signing secret — do NOT share with prod) ----
JWT_SECRET=
JWT_EXPIRY=7d

# ---- PAT (Personal Access Tokens) ----
# HMAC pepper for hashing PATs before DB storage. Random 32+ bytes.
# A leaked DB without this pepper still can't have its PAT hashes rainbow-tabled.
PAT_HMAC_PEPPER=

# ---- AI service (market-ai-service) ----
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_API_KEY=
BACKEND_API_KEY=

# ---- Blockchain (contract addresses filled in after Phase 3 redeploy) ----
BLOCKCHAIN_RPC_URL=https://testnet.sapphire.oasis.io
BACKEND_WALLET_PRIVATE_KEY=
MEMORY_NFT_CONTRACT_ADDRESS=
CONTEXT_REGISTRY_ADDRESS=
API_BASE_URL=http://localhost:5001

# ---- Cloudinary (cover image uploads) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
