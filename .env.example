# =====================================================================
# plurality-market-backend — example env. Copy to .env and fill in.
# Port choices below avoid colliding with the prod stack (backend=5000,
# memory-studio=3000, prod-mcp=5050). Adjust if you have other defaults.
# =====================================================================

# ---- Server ----
PORT=5001
NODE_ENV=development
ENABLE_SWAGGER_DOCS=true
PLURALITY_BACKEND=http://localhost:5001

# CORS — only this origin can hit the API with credentials
MARKETPLACE_UI_ORIGIN=http://localhost:3001

# ---- Database (new, separate from prod) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=plurality_market
DB_USER=
DB_PASSWORD=
# Optional: CA bundle for verified TLS to managed Postgres (e.g. AWS RDS)
# DB_SSL_CA_PATH=certificates/eu-north-1-bundle.pem

# ---- JWT (wallet-session signing secret — do NOT share with prod) ----
JWT_SECRET=
JWT_EXPIRY=7d

# ---- PAT (Personal Access Tokens) ----
# HMAC pepper for hashing PATs before DB storage. Random 32+ bytes.
# A leaked DB without this pepper still can't have its PAT hashes rainbow-tabled.
PAT_HMAC_PEPPER=

# ---- AI service (market-ai-service) ----
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_API_KEY=
BACKEND_API_KEY=

# ---- Blockchain (Oasis Sapphire) ----
# No backend wallet key needed: all on-chain writes are signed by the user.
BLOCKCHAIN_RPC_URL=https://testnet.sapphire.oasis.io
MEMORY_NFT_CONTRACT_ADDRESS=
CONTEXT_REGISTRY_ADDRESS=
REPUTATION_REGISTRY_ADDRESS=
API_BASE_URL=http://localhost:5001

# ---- Cloudinary (cover image uploads) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Marketplace curation (team-only) ----
# Comma-separated wallet addresses allowed to set the "featured" flag that
# pins buckets to the homepage hero slider. Case-insensitive. Leave empty to
# disable curation entirely (the endpoint then answers 404 for everyone).
ADMIN_WALLETS=

# ---- SIWE login binding ----
# Chain the SIWE message must be signed for (Oasis Sapphire testnet).
# The login domain is derived from MARKETPLACE_UI_ORIGIN above.
SIWE_CHAIN_ID=23295

# ---- Search quota (optional; defaults 2000/8000, 0 disables) ----
# Daily caps for /mcp/semantic-search: per-wallet bounds one account's
# volume, per-IP bounds one machine scripting many wallets. Searches fan
# out one local vector query per owned/held bucket — real compute.
LLM_DAILY_SEARCH_LIMIT_PER_WALLET=2000
LLM_DAILY_SEARCH_LIMIT_PER_IP=8000

# ---- Creator verification badges (optional; leave unset to disable) ----
# Verifies smart-profile platform disclosures against the on-chain EAS
# attestation on Oasis Sapphire before storing badge rows. Without
# SAPPHIRE_* the badge endpoints refuse writes; everything else runs.
SAPPHIRE_EAS_ADDRESS=
SAPPHIRE_PRIVATE_SCHEMA_UID=
# smart-profile API used to confirm a disclosure comes from the wallet's
# LATEST attestation. Unset skips that one check (logged).
SMART_PROFILE_API_URL=
# 1 = accept self-signed TLS on SMART_PROFILE_API_URL (local dev only).
SMART_PROFILE_API_INSECURE_TLS=
